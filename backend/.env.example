# ==============================================================================
# PoliceHQ GeoAttend Backend Configuration (Production & Development Template)
# ==============================================================================

PROJECT_NAME="PoliceHQ GeoAttend"

# Environment: "development" or "production"
# In production, set DEBUG=false to disable hot-reloading and verbose debug logs.
ENVIRONMENT="production"
DEBUG=false

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# CRITICAL: In production, generate a secure 64-character random key using:
#   openssl rand -hex 32
# or Python: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="replace-with-a-secure-random-64-character-production-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ------------------------------------------------------------------------------
# Database Connection (MongoDB / MongoDB Atlas)
# ------------------------------------------------------------------------------
# For local / Docker:
# MONGODB_URI="mongodb://localhost:27017"
#
# For MongoDB Atlas (Cloud Production):
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-url>/<db_name>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://admin:StrongPassword123@cluster0.abcde.mongodb.net/policehq_geoattend?retryWrites=true&w=majority"
MONGODB_DATABASE="policehq_geoattend"

# ------------------------------------------------------------------------------
# Default Headquarters Configuration (Eluru District Police HQ, AP)
# ------------------------------------------------------------------------------
DEFAULT_HQ_NAME="Eluru District Police Headquarters"
DEFAULT_HQ_ADDRESS="District Police Office, Sanivarapupeta, Eluru, Andhra Pradesh 534007"
DEFAULT_HQ_LATITUDE=16.7107
DEFAULT_HQ_LONGITUDE=81.0952
DEFAULT_GEOFENCE_RADIUS_METERS=100.0
DEFAULT_ACCURACY_THRESHOLD_METERS=35.0
DEFAULT_STALE_THRESHOLD_SECONDS=300
GEOFENCE_HYSTERESIS_METERS=10.0
ENTRY_CONFIRMATION_COUNT=2
EXIT_CONFIRMATION_COUNT=2

# ------------------------------------------------------------------------------
# CORS & Server Network Settings
# ------------------------------------------------------------------------------
# In production, specify your Vercel deployment URL(s) and any custom domains.
# Accepts JSON array: ["https://policehq-admin.vercel.app","http://localhost:5173"]
# Or comma-separated string: https://policehq-admin.vercel.app,http://localhost:5173
CORS_ORIGINS=["https://policehq-admin.vercel.app","http://localhost:5173","http://localhost:3000"]

# Host & Port (cloud platforms like Render/Railway automatically inject $PORT)
HOST="0.0.0.0"
PORT=8000
