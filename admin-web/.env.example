# Backend REST API base URL (including /api/v1 or root domain)
# Local development:
VITE_API_URL=http://localhost:8000/api/v1

# Backend Real-time WebSocket URL
# Local development:
VITE_WS_URL=ws://localhost:8000/api/v1/ws

# Production Example (Render / Railway / Cloud VM / VPS):
# VITE_API_URL=https://policehq-backend.onrender.com/api/v1
# VITE_WS_URL=wss://policehq-backend.onrender.com/api/v1/ws
